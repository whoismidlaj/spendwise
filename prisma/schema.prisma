generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  currency  String   @default("INR")
  cashBuffer Decimal @default(0) @db.Decimal(15, 2)
  createdAt DateTime @default(now())

  accounts          Account[]
  creditCards       CreditCard[]
  transactions      Transaction[]
  debts             Debt[]
  incomeSources     IncomeSource[]
  paymentPlans      PaymentPlan[]
  mobileSessions    MobileSession[]
}

model MobileSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType @default(BANK)
  balance   Decimal     @db.Decimal(15, 2) @default(0)
  color     String      @default("#01696f")
  institution String    @default("OTHER")
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]      @relation("AccountTransactions")
  toTransactions    Transaction[]      @relation("ToAccountTransactions")
  incomeSources     IncomeSource[]
  paymentPlans      PaymentPlan[]
}

enum AccountType {
  BANK
  WALLET
  CASH
}

enum IncomeType {
  SALARY
  FREELANCE
  RENTAL
  INTEREST
  OTHER
}

enum IncomeFrequency {
  MONTHLY
  WEEKLY
  ONE_TIME
}

enum IncomeStatus {
  EXPECTED
  RECEIVED
  SKIPPED
}

enum PaymentPlanType {
  RENT
  UTILITY
  SUBSCRIPTION
  INSURANCE
  FAMILY
  SAVINGS
  OTHER
}

model IncomeSource {
  id                String          @id @default(cuid())
  userId            String
  accountId         String?
  name              String
  type              IncomeType      @default(SALARY)
  frequency         IncomeFrequency @default(MONTHLY)
  payday            Int?
  // DAY_OF_MONTH uses payday; LAST_WORKING_DAY pays on the last Monday-Friday of the month.
  paydayRule        String          @default("DAY_OF_MONTH")
  grossAmount       Decimal?        @db.Decimal(15, 2)
  expectedInHand    Decimal         @db.Decimal(15, 2)
  defaultDeductions Decimal         @default(0) @db.Decimal(15, 2)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  occurrences IncomeOccurrence[]
}

model IncomeOccurrence {
  id             String       @id @default(cuid())
  incomeSourceId String
  expectedDate   DateTime
  expectedAmount Decimal      @db.Decimal(15, 2)
  actualAmount   Decimal?     @db.Decimal(15, 2)
  receivedAt     DateTime?
  status         IncomeStatus @default(EXPECTED)
  notes          String?
  createdAt      DateTime     @default(now())

  incomeSource IncomeSource @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)

  @@unique([incomeSourceId, expectedDate])
}

model PaymentPlan {
  id          String          @id @default(cuid())
  userId      String
  accountId   String?
  name        String
  type        PaymentPlanType @default(OTHER)
  amount      Decimal         @db.Decimal(15, 2)
  dueDay      Int
  isEssential Boolean         @default(true)
  isActive    Boolean         @default(true)
  startDate   DateTime        @default(now())
  endDate     DateTime?
  // Archived records leave Payments and the forecast; history stays viewable.
  archivedAt  DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payments   PaymentPlanOccurrence[]
}

model PaymentPlanOccurrence {
  id            String      @id @default(cuid())
  paymentPlanId String
  dueDate       DateTime
  amount        Decimal     @db.Decimal(15, 2)
  paidAt        DateTime?
  accountId     String?
  // Internal ledger entry created when the occurrence was marked paid; used for exact reversal.
  transactionId String?
  createdAt     DateTime    @default(now())

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@unique([paymentPlanId, dueDate])
}

model CreditCard {
  id            String   @id @default(cuid())
  userId        String
  name          String
  bank          String
  institution   String   @default("OTHER")
  totalLimit    Decimal  @db.Decimal(15, 2)
  usedLimit     Decimal  @db.Decimal(15, 2) @default(0)
  dueAmount     Decimal  @db.Decimal(15, 2) @default(0)
  expectedDue   Decimal? @db.Decimal(15, 2)
  billDueDate   DateTime?
  minimumDue    Decimal  @db.Decimal(15, 2) @default(0)
  dueDate       Int
  statementDate Int
  color         String   @default("#006494")
  type          String   @default("CARD")
  isActive      Boolean  @default(true)
  reminderDays  Int      @default(3)
  createdAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        CardBill[]
  payments     CardPayment[]
}

// One statement cycle. Snapshotted when a payment is recorded so history stays reproducible.
model CardBill {
  id              String    @id @default(cuid())
  creditCardId    String
  statementDate   DateTime?
  dueDate         DateTime
  statementAmount Decimal   @db.Decimal(15, 2)
  minimumDue      Decimal   @default(0) @db.Decimal(15, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(15, 2)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  creditCard CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  payments   CardPayment[]

  @@unique([creditCardId, dueDate])
}

model CardPayment {
  id            String   @id @default(cuid())
  creditCardId  String
  cardBillId    String?
  amount        Decimal  @db.Decimal(15, 2)
  paidDate      DateTime @default(now())
  accountId     String?
  transactionId String?
  // Exact amounts taken off the live card fields, so undo restores them precisely.
  usedDelta     Decimal  @db.Decimal(15, 2)
  dueDelta      Decimal  @db.Decimal(15, 2)
  minimumDelta  Decimal  @db.Decimal(15, 2)
  expectedDelta Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  cardBill   CardBill?  @relation(fields: [cardBillId], references: [id], onDelete: SetNull)
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  accountId    String?
  managedPayment Boolean       @default(false)
  toAccountId  String?
  creditCardId String?
  type         TransactionType
  amount       Decimal         @db.Decimal(15, 2)
  name         String
  description  String?
  date         DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?    @relation("AccountTransactions", fields: [accountId], references: [id])
  toAccount  Account?    @relation("ToAccountTransactions", fields: [toAccountId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum DebtType {
  PERSONAL
  LOAN
  CREDIT_LINE
  PAY_LATER
}

enum DebtDirection {
  BORROWED
  LENT
}

enum DebtPriority {
  LOW
  MEDIUM
  HIGH
}

model Debt {
  id            String       @id @default(cuid())
  userId        String
  name          String
  direction     DebtDirection @default(BORROWED)
  type          DebtType
  amount        Decimal      @db.Decimal(15, 2)
  remaining     Decimal      @db.Decimal(15, 2)
  interestRate  Decimal      @db.Decimal(5, 2)  @default(0)
  
  // Recurring/Installment Details
  isRecurring   Boolean      @default(false)
  paymentDate   Int?         
  paymentAmount Decimal?     @db.Decimal(15, 2)
  totalInstallments Int?
  startDate     DateTime?
  // Official lender totals may differ from a rounded/generated schedule.
  totalRepaymentAmount Decimal? @db.Decimal(15, 2)
  totalInterestAmount  Decimal? @db.Decimal(15, 2)
  // Optional lender-provided schedule. Each item may contain dueDate, amount,
  // principal, interest, and opening/closing balances.
  installmentSchedule Json?
  
  // Normal/One-time Details
  deadline      DateTime?    
  priority      DebtPriority @default(MEDIUM)
  
  description   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      DebtPayment[]
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  amount    Decimal  @db.Decimal(15, 2)
  principalAmount Decimal? @db.Decimal(15, 2)
  interestAmount  Decimal? @db.Decimal(15, 2)
  // Stable link to the installment this payment settled (null for ad-hoc payments).
  installmentNumber Int?
  scheduledDueDate  DateTime?
  // Internal ledger entry created for this payment, used for exact reversal.
  transactionId String?
  paidDate  DateTime @default(now())
  accountId String?  

  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([debtId, installmentNumber])
}
