generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  currency  String   @default("INR")
  createdAt DateTime @default(now())

  accounts          Account[]
  creditCards       CreditCard[]
  transactions      Transaction[]
  categories        Category[]
  recurringExpenses RecurringExpense[]
  budgets           Budget[]
  debts             Debt[]
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType @default(BANK)
  balance   Decimal     @db.Decimal(15, 2) @default(0)
  color     String      @default("#01696f")
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
}

enum AccountType {
  BANK
  WALLET
  CASH
}

model CreditCard {
  id            String   @id @default(cuid())
  userId        String
  name          String
  bank          String
  totalLimit    Decimal  @db.Decimal(15, 2)
  usedLimit     Decimal  @db.Decimal(15, 2) @default(0)
  dueAmount     Decimal  @db.Decimal(15, 2) @default(0)
  dueDate       Int
  statementDate Int
  color         String   @default("#006494")
  isActive      Boolean  @default(true)
  reminderDays  Int      @default(3)
  createdAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Category {
  id       String          @id @default(cuid())
  userId   String
  name     String
  icon     String
  color    String
  type     TransactionType
  isSystem Boolean         @default(false)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  accountId    String?
  creditCardId String?
  categoryId   String?
  type         TransactionType
  amount       Decimal         @db.Decimal(15, 2)
  name         String
  description  String?
  date         DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [accountId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model RecurringExpense {
  id             String        @id @default(cuid())
  userId         String
  accountId      String?
  name           String
  type           RecurringType @default(EMI)
  loanAmount     Decimal?      @db.Decimal(15, 2)
  interestRate   Decimal?      @db.Decimal(5, 2)
  additionalFees Decimal?      @db.Decimal(15, 2) @default(0)
  emiAmount      Decimal       @db.Decimal(15, 2)
  emiDate        Int
  totalEMIs      Int?
  paidEMIs       Int           @default(0)
  startDate      DateTime
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?     @relation(fields: [accountId], references: [id])
  payments EMIPayment[]
}

enum RecurringType {
  EMI
  LOAN
  SUBSCRIPTION
  UTILITY
  RENT
  OTHER
}

model EMIPayment {
  id                 String   @id @default(cuid())
  recurringExpenseId String
  amount             Decimal  @db.Decimal(15, 2)
  paidDate           DateTime
  emiNumber          Int

  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
}

model Budget {
  id         String  @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal @db.Decimal(15, 2)
  month      Int
  year       Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}

enum DebtType {
  PERSONAL
  LOAN
  CREDIT_LINE
  PAY_LATER
}

enum DebtPriority {
  LOW
  MEDIUM
  HIGH
}

model Debt {
  id            String       @id @default(cuid())
  userId        String
  name          String
  type          DebtType
  amount        Decimal      @db.Decimal(15, 2)
  remaining     Decimal      @db.Decimal(15, 2)
  interestRate  Decimal      @db.Decimal(5, 2)  @default(0)
  
  // Recurring/Installment Details
  isRecurring   Boolean      @default(false)
  paymentDate   Int?         
  paymentAmount Decimal?     @db.Decimal(15, 2)
  
  // Normal/One-time Details
  deadline      DateTime?    
  priority      DebtPriority @default(MEDIUM)
  
  description   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      DebtPayment[]
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  amount    Decimal  @db.Decimal(15, 2)
  paidDate  DateTime @default(now())
  accountId String?  

  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
}

